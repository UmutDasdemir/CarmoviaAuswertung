FROM node:24-alpine AS build

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . ./
RUN npm run build

FROM nginx:1.29-alpine

RUN apk add --no-cache apache2-utils
COPY nginx.private.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist/client/ /usr/share/nginx/html/
COPY docker-entrypoint-private.sh /usr/local/bin/carmovia-dashboard-entrypoint
RUN chmod 0755 /usr/local/bin/carmovia-dashboard-entrypoint

EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/carmovia-dashboard-entrypoint"]

